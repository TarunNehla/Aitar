DATABASE_URL=postgresql://user:password@host/database?sslmode=require
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Upstream inference providers for OpenRouter, most preferred first.
# Empty accepts OpenRouter's own routing.
OPENROUTER_PROVIDERS=
# true treats the list as a preference order and permits other providers.
# false pins requests to OPENROUTER_PROVIDERS and fails when none can serve the model.
OPENROUTER_ALLOW_FALLBACKS=true

PORT=3000
WORKSPACE_ROOT=.cloud-agent
MAX_ACTIVE_RUNS=1
CHAT_IDLE_MINUTES=30
EVICTION_INTERVAL_SECONDS=60
RUN_MAX_TURNS=30
RUN_MAX_COST_USD=2
# Chat container limits. These are invisible platform boundaries, never chat permissions.
# The image needs a POSIX shell, coreutils, GNU grep, and find.
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=512
# Applied only on Docker storage drivers that support per-container quotas.
SANDBOX_DISK_GB=10
# Ceiling for the bash tool. A model-supplied timeout is clamped to this.
SANDBOX_TIMEOUT_SECONDS=300
# Concurrent start_process processes per chat.
SANDBOX_MAX_PROCESSES=8

# Browser sidecar. Started lazily on the first browser tool call and removed
# after BROWSER_IDLE_MINUTES, so a chat that never browses costs no RAM or CPU.
# Build the image once with scripts/build-browser-image.sh.
BROWSER_ENABLED=true
BROWSER_IMAGE=aitar-browser:chromium
BROWSER_MEMORY_MB=1024
BROWSER_CPUS=0.5
BROWSER_PIDS_LIMIT=256
BROWSER_IDLE_MINUTES=10
BROWSER_MAX_TABS=2
BROWSER_ACTION_TIMEOUT_SECONDS=30
BROWSER_NAVIGATION_TIMEOUT_SECONDS=60
BROWSER_SCREENSHOT_MAX_BYTES=10485760

# Screenshot understanding. auto sends the screenshot straight to the run's model
# when OpenRouter reports image input support, and otherwise delegates it to
# VISION_MODEL. always_delegate always delegates; disabled captures screenshots
# without any visual analysis.
VISION_ROUTING_MODE=auto
# Any multimodal model OpenRouter serves, billed on OPENROUTER_API_KEY. Leaving it
# empty turns delegation off, so a text-only run captures screenshots without
# analysing them. Avoid :batch endpoints, -preview builds, and the -image models,
# which generate images rather than describe them.
VISION_MODEL=google/gemini-3.7-flash
# Overrides metadata when a provider advertises the wrong modality.
# Format: model-a=image,model-b=text
VISION_CAPABILITY_OVERRIDES=
VISION_CAPABILITY_CACHE_TTL_SECONDS=21600
VISION_REQUEST_TIMEOUT_SECONDS=60
VISION_MAX_IMAGE_BYTES=10485760
LOG_LEVEL=debug
LOG_PRETTY=true

# Public origin of the application. Same origin for the frontend and the API.
# Development uses the Vite dev server; production must use HTTPS.
APP_URL=http://localhost:5173

# Server-only secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client, identity scopes only (openid, email, profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App OAuth credentials, used for sign-in identity only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App credentials, used for private repository access
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Lifetime of the signed GitHub installation state, in seconds
GITHUB_INSTALLATION_STATE_TTL_SECONDS=600
